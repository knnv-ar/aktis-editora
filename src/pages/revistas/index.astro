---
import Base from '../../layouts/Base.astro';
import { revistas } from '../../lib/contenido';
import { t } from '../../i18n/ui';

const lista = await revistas();
---

<Base titulo={t('es', 'lista.revistas')}>
  <h1>{t('es', 'lista.revistas')}</h1>
  {
    lista.length === 0 ? (
      <p>{t('es', 'lista.vacia')}</p>
    ) : (
      <ul class="grilla">
        {lista.map((r) => (
          <li>
            <h2>
              <a href={`/revistas/${r.id}/`}>{r.data.nombre}</a>
            </h2>
            <p class="meta">
              {r.data.periodicidad}
              {r.data.issn_en_linea && ` · ISSN ${r.data.issn_en_linea}`}
            </p>
          </li>
        ))}
      </ul>
    )
  }
</Base>
