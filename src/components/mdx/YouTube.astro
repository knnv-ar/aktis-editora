---
// <YouTube id="dQw4w9WgXcQ" titulo="Registro de la performance" />
// Carga liviana: muestra la miniatura y solo inserta el reproductor (youtube-nocookie)
// cuando el lector hace clic. Así no se cargan rastreadores de Google al abrir la página.
interface Props {
  id: string;
  titulo: string;
  inicio?: number;
}
const { id, titulo, inicio } = Astro.props;
if (!/^[\w-]{11}$/.test(id)) throw new Error(`YouTube: id inválido «${id}»`);
const params = new URLSearchParams({ autoplay: '1', rel: '0' });
if (inicio) params.set('start', String(inicio));
const embed = `https://www.youtube-nocookie.com/embed/${id}?${params}`;
const miniatura = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---

<figure class="youtube" data-pagefind-ignore>
  <aktis-youtube data-embed={embed} data-titulo={titulo}>
    <a href={`https://www.youtube.com/watch?v=${id}`} class="youtube__portada">
      <img src={miniatura} alt="" loading="lazy" width="480" height="360" />
      <span class="youtube__boton" aria-hidden="true">▶</span>
      <span class="youtube__texto">Reproducir video: {titulo}</span>
    </a>
  </aktis-youtube>
  <figcaption>{titulo}</figcaption>
</figure>

<script>
  class AktisYouTube extends HTMLElement {
    connectedCallback() {
      this.querySelector('a')?.addEventListener('click', (e) => {
        e.preventDefault();
        const iframe = document.createElement('iframe');
        iframe.src = this.dataset.embed!;
        iframe.title = this.dataset.titulo ?? 'Video';
        iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        this.replaceChildren(iframe);
        iframe.focus();
      });
    }
  }
  customElements.define('aktis-youtube', AktisYouTube);
</script>

<style>
  .youtube {
    margin: 2em 0;
  }
  aktis-youtube {
    display: block;
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: 3px;
    overflow: hidden;
  }
  aktis-youtube :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .youtube__portada {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
  }
  .youtube__portada img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
  }
  .youtube__boton {
    position: absolute;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
    width: 4.5rem;
    height: 3.2rem;
    display: grid;
    place-items: center;
    background: var(--acento);
    color: #fff;
    border-radius: 12px;
    font-size: 1.5rem;
  }
  .youtube__texto {
    position: absolute;
    left: -9999px;
  }
  figcaption {
    margin-top: 0.5em;
    font-family: var(--sans);
    font-size: 0.85rem;
    color: var(--tinta-2);
  }
</style>
