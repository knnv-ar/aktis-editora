---
// Tapa de una publicación: la imagen propia si existe; si no, una tapa tipográfica
// con el color de la colección (la misma idea que usará la plantilla Typst).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  titulo: string;
  autores?: string;
  imagen?: ImageMetadata;
  color?: string;
  coleccion?: string;
  ancho?: number;
}
const { titulo, autores, imagen, color = '#9A5B00', coleccion, ancho = 360 } = Astro.props;
---

{
  imagen ? (
    <Image src={imagen} alt={`Tapa de «${titulo}»`} width={ancho} class="tapa" />
  ) : (
    <div class="tapa tapa--generada" style={`--color:${color}`} role="img" aria-label={`Tapa de «${titulo}»`}>
      {coleccion && <span class="tapa__coleccion">{coleccion}</span>}
      <span class="tapa__titulo">{titulo}</span>
      {autores && <span class="tapa__autores">{autores}</span>}
      <span class="tapa__sello">Áktis</span>
    </div>
  )
}

<style>
  .tapa {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: 3px;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.15), 0 6px 18px rgb(0 0 0 / 0.12);
  }
  .tapa--generada {
    background: var(--color);
    color: #fbf7f0;
    padding: 12% 10%;
    display: flex;
    flex-direction: column;
    gap: 0.6em;
    container-type: inline-size;
    font-family: var(--serif);
  }
  .tapa__coleccion {
    font-family: var(--sans);
    font-size: max(0.6rem, 5.5cqi);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .tapa__titulo {
    font-size: max(1rem, 11cqi);
    font-weight: 700;
    line-height: 1.1;
    margin-top: auto;
  }
  .tapa__autores {
    font-size: max(0.7rem, 6.5cqi);
  }
  .tapa__sello {
    margin-top: auto;
    font-weight: 700;
    font-size: max(0.7rem, 6cqi);
    opacity: 0.9;
  }
</style>
