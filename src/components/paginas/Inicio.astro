---
import { getCollection, getEntry } from 'astro:content';
import Ficha from '../ui/Ficha.astro';
import Tapa from '../ui/Tapa.astro';
import { libros, textos, articulos, autoresDe, nombresDe } from '../../lib/contenido';
import { t, RUTAS, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

type Item = { href: string; titulo: string; autores: string; etiqueta: string; fecha: Date; tapa?: any; color?: string; coleccion?: string; resumen?: string };
const items: Item[] = [];
for (const l of await libros()) {
  const c = await getEntry(l.data.coleccion);
  items.push({
    href: `/libros/${l.id}/`,
    titulo: l.data.titulo,
    autores: nombresDe(await autoresDe(l.data.autores)),
    etiqueta: c?.data.nombre ?? 'Libro',
    fecha: l.data.fecha_publicacion,
    tapa: l.data.tapa ?? null,
    color: c?.data.color,
    coleccion: c?.data.nombre,
  });
}
for (const { articulo, numero } of await articulos())
  items.push({
    href: `/revistas/${articulo.id}/`,
    titulo: articulo.data.titulo,
    autores: nombresDe(await autoresDe(articulo.data.autores)),
    etiqueta: lang === 'es' ? 'Artículo' : 'Article',
    fecha: numero.data.fecha_publicacion,
    resumen: lang === 'en' && articulo.data.resumen_en ? articulo.data.resumen_en : articulo.data.resumen,
  });
for (const x of await textos())
  items.push({
    href: `/textos/${x.id}/`,
    titulo: x.data.titulo,
    autores: nombresDe(await autoresDe(x.data.autores)),
    etiqueta: lang === 'es' ? 'Texto' : 'Text',
    fecha: x.data.fecha_publicacion,
    resumen: lang === 'en' && x.data.resumen_en ? x.data.resumen_en : x.data.resumen,
  });
const novedades = items.sort((a, b) => b.fecha.getTime() - a.fecha.getTime()).slice(0, 8);
const colecciones = (await getCollection('colecciones')).sort((a, b) => a.data.orden - b.data.orden);
---

<section class="portada">
  <h1>
    <span class="portada__griego" lang="grc">ἀκτίς</span>
    {t(lang, 'sitio.lema')}
  </h1>
</section>

<section>
  <h2>{t(lang, 'inicio.novedades')}</h2>
  {
    novedades.length === 0 ? (
      <p class="meta">{t(lang, 'inicio.vacio')}</p>
    ) : (
      <ul class="grilla">
        {novedades.map((i) => (
          <li>
            <Ficha href={i.href} titulo={i.titulo} autores={i.autores} etiqueta={i.etiqueta} resumen={i.resumen}>
              {i.coleccion !== undefined && (
                <Tapa slot="tapa" titulo={i.titulo} autores={i.autores} imagen={i.tapa ?? undefined} color={i.color} coleccion={i.coleccion} />
              )}
            </Ficha>
          </li>
        ))}
      </ul>
    )
  }
</section>

<section class="servicios">
  <h2>{t(lang, 'inicio.servicios.titulo')}</h2>
  <p>{t(lang, 'inicio.servicios.texto')}</p>
  <a class="boton" href={RUTAS.servicios[lang]}>{t(lang, 'inicio.servicios.boton')}</a>
</section>

<section>
  <h2>{t(lang, 'inicio.colecciones')}</h2>
  <ul class="colecciones">
    {
      colecciones.map((c) => (
        <li style={`--color:${c.data.color}`}>
          <a href={`/colecciones/${c.id}/`}>{c.data.nombre}</a>
          <p>{lang === 'en' && c.data.descripcion_en ? c.data.descripcion_en : c.data.descripcion_es}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .portada {
    padding-block: 1.5rem 3rem;
  }
  .portada h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(1.9rem, 5vw, 3.2rem);
    max-width: 22ch;
    margin: 0;
  }
  .portada__griego {
    display: block;
    font-size: 0.5em;
    color: var(--acento);
    font-style: italic;
    margin-bottom: 0.3em;
  }
  section + section {
    margin-top: 3.5rem;
  }
  .servicios {
    background: var(--papel-2);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    padding: 1.75rem;
  }
  .servicios h2 {
    margin-top: 0;
  }
  .servicios p {
    max-width: 48ch;
  }
  .colecciones {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
  }
  .colecciones li {
    border-top: 4px solid var(--color);
    padding-top: 0.6rem;
  }
  .colecciones a {
    font-weight: 700;
    color: var(--tinta);
    text-decoration: none;
  }
  .colecciones p {
    margin: 0.3rem 0 0;
    font-size: 0.92rem;
    color: var(--tinta-2);
  }
</style>
