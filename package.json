{
  "name": "aktis-editora",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Portal de Áktis Editora: libros, revistas y textos en acceso abierto.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "validar": "node scripts/validar-contenido.mjs",
    "build": "npm run validar && astro build && pagefind --site dist",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.6",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "astro": "^7.4.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "pagefind": "^1.6.0",
    "wrangler": "^4.157.0"
  }
}
